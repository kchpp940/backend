APP_PORT=3000
APP_HOST="0.0.0.0"
APP_NAME="Todo_inst1"

API_PREFIX="api"
# Boolean: true | false | 1 | 0 | yes | no (case-insensitive, trimmed)
# ✅ OK:  API_ALLOWED_NON_BROWSER_ORIGINS=True  TRUE  "true"  YES  1
# ❌ WRONG: API_ALLOWED_NON_BROWSER_ORIGINS=enabled  on  yep  nope
API_ALLOWED_NON_BROWSER_ORIGINS=true
# JSON array of strings — must be valid JSON with brackets and quoted strings
# ❌ WRONG: API_ALLOWED_ORIGINS=http://localhost:3001,http://example.com
# ❌ WRONG: API_ALLOWED_ORIGINS=[http://localhost:3001]
# ❌ WRONG: API_ALLOWED_ORIGINS="http://localhost:3001","http://example.com"
API_ALLOWED_ORIGINS=["http://localhost:3001","http://example.com"]

# Boolean: true | false | 1 | 0 | yes | no (case-insensitive, trimmed)
LOG_PRETTY=true
# JSON array of strings — empty array is allowed
# ❌ WRONG: LOG_EXCLUDE_ENDPOINTS=/health,/metrics
# ❌ WRONG: LOG_EXCLUDE_ENDPOINTS=[/health]
LOG_EXCLUDE_ENDPOINTS=[]
LOG_LEVEL="info"

# Boolean: true | false | 1 | 0 | yes | no (case-insensitive)
SWAGGER_ENABLED=true
SWAGGER_USERNAME="admin"
SWAGGER_PASSWORD="admin"
SWAGGER_ENDPOINT="/docs"

DATABASE_USER="user"
DATABASE_PASSWORD="user"
DATABASE_HOST="localhost"
DATABASE_NAME="app"
DATABASE_PORT="5432"
# Boolean: true | false | 1 | 0 | yes | no (case-insensitive)
DATABASE_SSL=false
# JSON array of LogLevel — allowed values: "query" | "error" | "info" | "warn"
# ❌ WRONG: DATABASE_LOG_LEVELS=query,error
# ❌ WRONG: DATABASE_LOG_LEVELS=["query","debug"]
DATABASE_LOG_LEVELS=["query","error","info","warn"]
# Boolean: true | false | 1 | 0 | yes | no (case-insensitive)
DATABASE_FAIL_FAST=true

# Boolean: true | false | 1 | 0 | yes | no (case-insensitive)
REDIS_ENABLED=true
REDIS_HOST="localhost"
REDIS_PORT=6379

THROTTLE_TTL=20000
THROTTLE_LIMIT=10

HEALTH_CHECK_TRIGGER_MS=15000

# Boolean: true | false | 1 | 0 | yes | no (case-insensitive)
SENTRY_ENABLED=false
# JSON array of strings — must be valid JSON with brackets and quoted strings
# ❌ WRONG: SENTRY_IGNORED_ERRORS=QueryFailedError,NotFoundError
# ❌ WRONG: SENTRY_IGNORED_ERRORS=[QueryFailedError]
SENTRY_IGNORED_ERRORS=["QueryFailedError"]
SENTRY_DSN=""
